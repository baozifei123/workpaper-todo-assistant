    { "id": "scope-unclear", "from": "scope_check", "to": "clarify", "label": "目标或约束不清", "variant": "security", "role": "branch" },
    { "id": "clarification-return", "from": "clarify", "to": "scope_check", "label": "补充信息", "variant": "dashed", "role": "return" },
    { "id": "scope-ready", "from": "scope_check", "to": "archify_plan", "label": "明确", "variant": "emphasis", "role": "main" },
    { "id": "plan-to-decompose", "from": "archify_plan", "to": "decompose_tasks", "variant": "default" },
    { "id": "decompose-to-dependency", "from": "decompose_tasks", "to": "dependency_check", "variant": "default" },
    { "id": "independent-tasks", "from": "dependency_check", "to": "parallel_execution", "label": "互相独立", "variant": "emphasis", "role": "branch" },
    { "id": "dependent-tasks", "from": "dependency_check", "to": "sequential_execution", "label": "存在依赖", "variant": "default", "role": "branch" },
    { "id": "parallel-to-integrate", "from": "parallel_execution", "to": "integrate_results", "label": "结果返回", "variant": "default" },
    { "id": "sequential-to-integrate", "from": "sequential_execution", "to": "integrate_results", "label": "全部完成", "variant": "default" },
    { "id": "integrate-to-check", "from": "integrate_results", "to": "acceptance_check", "variant": "default" },
    { "id": "check-passed", "from": "acceptance_check", "to": "deliver", "label": "通过", "variant": "emphasis", "role": "main" },
    { "id": "check-failed", "from": "acceptance_check", "to": "rework", "label": "缺项或冲突", "variant": "security", "role": "error" },
    { "id": "rework-loop", "from": "rework", "to": "decompose_tasks", "label": "调整后重派", "variant": "dashed", "role": "return" }
